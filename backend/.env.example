# Copie para .env e ajuste.
DATABASE_URL=sqlite:///./intelisac.db
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
ACCESS_TOKEN_MINUTES=60
# dias sem usar até pedir o login de novo (cada uso renova)
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Usuário administrador criado pelo seed (python -m app.seed) — só para desenvolvimento.
SEED_ACCOUNT_NAME=InteliSac
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@intelisac.local
SEED_ADMIN_PASSWORD=troque-por-uma-senha-longa

# WhatsApp por QR code (pasta whatsapp-gateway/). O segredo tem que ser igual nos dois .env.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:8020
GATEWAY_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Supabase Auth (login com e-mail e senha guardados no Supabase).
# Supabase → Project Settings → API Keys. Não cole essas chaves no chat.
SUPABASE_URL=https://<ref-do-projeto>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Simulador (cliente de mentira para testes). Padrão: ligado no PC, DESLIGADO no servidor.
# ENABLE_SIMULATOR=true

# No servidor (Render) a API entra em modo produção sozinha (RENDER=true) e NÃO sobe com
# JWT_SECRET/GATEWAY_SECRET curtos, CORS com localhost, sem Supabase ou com SQLite.
# Fora do Render, use APP_ENV=production para o mesmo comportamento.
